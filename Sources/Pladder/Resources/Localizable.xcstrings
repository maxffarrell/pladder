    "Mute audio while dictating": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton beim Diktieren stummschalten"
          }
        }
      }
    },
    "Apple Core AI · on-device · 25 languages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Core AI · lokal · 25 Sprachen"
          }
        }
      }
    },
    "Needed for a modifier-only key such as Right Command, for the send key and for pasting. Without it Option+Space still works and the text is copied for you to paste with ⌘V; a standard account needs an administrator to switch it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig für eine reine Sondertaste wie die rechte Befehlstaste, für die Sendetaste und fürs Einfügen. Ohne sie funktioniert Wahltaste + Leertaste weiterhin, der Text wird aber nur kopiert, du fügst ihn dann mit ⌘V ein. In einem Standardaccount muss ein Admin das einschalten."
          }
        }
      }
    },
    "Not requested yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht angefragt."
          }
        }
      }
    },
