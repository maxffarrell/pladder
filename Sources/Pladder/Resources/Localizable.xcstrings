      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemächlich"
          }
        }
      }
    },
    "Click, then press the key or combination to use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, dann die Taste oder Kombination drücken."
          }
        }
      }
    },
    "Click, then press the key or combination to use. Without Accessibility the key must include a regular key, for example Control+Shift+D.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, dann die Taste oder Kombination drücken. Ohne Bedienungshilfen braucht die Kombination eine normale Taste, zum Beispiel Ctrl + Umschalttaste + D."
          }
        }
      }
    },
    "Compact": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt"
          }
        }
      }
    },
    "Copied — press ⌘V": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert — ⌘V drücken"
          }
        }
      }
    },
    "Could not create the paste keystroke. Try again, or restart Pladder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tastendruck zum Einfügen konnte nicht ausgelöst werden. Versuch es noch mal oder starte Pladder neu."
          }
        }
      }
    },
    "Could not read that file. It should be a JSON array of { from, to, matchCase }.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden. Erwartet wird ein JSON-Array aus { from, to, matchCase }."
          }
        }
      }
    },
    "Could not write that file: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gespeichert werden: %@"
