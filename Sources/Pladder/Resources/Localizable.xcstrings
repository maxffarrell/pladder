    "Hold to record, release to insert. Press the send key while recording and Return is pressed after the text. Click a field and press any key combination to assign it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten zum Aufnehmen, loslassen zum Einfügen. Drückst du während der Aufnahme die Sendetaste, wird nach dem Text Enter gedrückt. Klick auf ein Feld und drück eine Tastenkombination, um sie zuzuweisen."
          }
        }
      }
    },
